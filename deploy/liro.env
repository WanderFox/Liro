# Liro server settings. After editing: sudo systemctl restart liro

# Name shown in clients when they discover the server
LIRO_NAME=Liro

# Main port (web, API, WebSocket; UDP discovery on the same port)
LIRO_PORT=1919

# Extra HTTP ports. 80 makes http://liro.loc work without ":1919". Leave empty to disable.
LIRO_EXTRA_PORTS=80

# Where boards and media are stored
LIRO_DATA=/var/lib/liro

# Name served by the built-in DNS responder and announced to clients
LIRO_HOSTNAME=liro.loc

# Built-in DNS responder for LIRO_HOSTNAME (UDP 53 on the LAN addresses).
# Useful when the router forwards the "loc" zone here, or clients use this server as DNS.
LIRO_DNS=1

# Address returned for liro.loc (empty = the server's LAN address on the interface asked)
LIRO_PUBLIC_IP=

# mDNS announcement (_liro._tcp) for client auto-discovery
LIRO_MDNS=1

# Max upload size per file, MB
LIRO_MAX_UPLOAD_MB=2048
